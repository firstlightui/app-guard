includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
        # Uses RequiresUnlock, so PHPStan analyses the trait.
        - tests/Fixtures/ProtectedScreen.php
    scanFiles:
        - vendor/nativephp/mobile/src/jump_bridge_functions.php
    level: 6
    tmpDir: build/phpstan
