{
    "name": "firstlightui/app-guard",
    "description": "Lock-screen building blocks for NativePHP Mobile: hide your app in the app switcher, cover it when it returns after a timeout, and copy secrets to a clipboard that clears itself.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "FirstlightUI\\AppGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FirstlightUI\\AppGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FirstlightUI\\AppGuard\\AppGuardServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^5.0",
        "orchestra/testbench": "^11.0",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.27"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    }
}
